{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "test/fixtures/**",
    "patches/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {},
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    }
  }
}
